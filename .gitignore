# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Environment Variables & Credentials
.env
.env.local
.env.*.local

# Python Bytecode & Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Databases & Local State
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Generated Runtime Outputs & Logs (preserve directory structure via .gitkeep)
outputs/simulated_emails/*
!outputs/simulated_emails/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
logs/*
!logs/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
