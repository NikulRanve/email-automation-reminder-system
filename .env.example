# Application Mode: 'simulation' or 'smtp' (simulation is default for safety)
EMAIL_MODE=simulation

# Database Configuration
DB_PATH=data/reminders.db

# SMTP Configuration (Placeholder credentials - never commit real credentials)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=your_secure_password_here
SENDER_EMAIL=reminders@example.com
SENDER_NAME=Email Reminder System

# Logging Configuration
LOG_LEVEL=INFO
